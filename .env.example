# Copy to .env.local for development. Set the same names in Vercel for deployments.
# Setup steps: docs/enquiries-setup.md

# Sanity: enquiry storage. The dataset must be PRIVATE.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=enquiries
# Editor token. Server only, never prefix with NEXT_PUBLIC_.
SANITY_API_WRITE_TOKEN=
# Optional. Deployed Studio URL, used for the "Open in Studio" link in notification emails.
SANITY_STUDIO_URL=

# Resend: email delivery
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. Avenor Digital Studio <enquiries@yourdomain.com>
RESEND_FROM_EMAIL=
# Inbox that receives new-enquiry notifications
ENQUIRY_NOTIFY_EMAIL=

# Signs the form timestamp and hashes IP addresses. At least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ENQUIRY_SECRET=

# Public site origin for canonicals, Open Graph, sitemap and structured data, e.g. https://yourdomain.com
# Optional: without it, Vercel's production alias (VERCEL_PROJECT_PRODUCTION_URL) is used.
NEXT_PUBLIC_SITE_URL=
